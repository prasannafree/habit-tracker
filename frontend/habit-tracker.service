[Unit]
Description=Habit Tracker Next.js Application
After=network.target habit-tracker-backend.service
Wants=habit-tracker-backend.service

[Service]
Type=simple
WorkingDirectory=/home/prasanna/Documents/my_projects/habit tracker/frontend
ExecStart=/usr/bin/npx next start -H 0.0.0.0
Restart=always
RestartSec=3
TimeoutStopSec=3s
KillMode=control-group
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
